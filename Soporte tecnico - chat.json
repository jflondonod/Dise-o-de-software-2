      "parameters": {
        "jsCode": "let inputData = $input.item.json.body;\n\nif (!inputData) {\n  inputData = $input.item.json;\n}\n\nlet userId = inputData.user_id || 1;\nlet ticketId = inputData.ticket_id || null;\n\n// Capturamos el mensaje desde 'mensaje' o desde 'intentar' / 'descripcion_problema'\nlet mensajeUsuario = inputData.mensaje || inputData.descripcion_problema || '';\n\nlet intentoActual = inputData.intento_actual || inputData.intentar || 1;\n\nlet accion = inputData.accion;\nif (!accion) {\n  accion = 'nuevo_mensaje';\n}\n\nlet codigoTicket = inputData.codigo_ticket;\nif (!codigoTicket) {\n  codigoTicket = 'TKT-' + Date.now();\n}\n\nreturn {\n  json: {\n    accion: accion,\n    user_id: userId,\n    ticket_id: ticketId,\n    codigo_ticket: codigoTicket,\n    mensaje: mensajeUsuario,\n    intento_actual: intentoActual,\n    emisor: 'usuario'\n  }\n};"
