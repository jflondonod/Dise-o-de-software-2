        "operation": "executeQuery",
        "query": "WITH ticket_existente AS (\n    SELECT id FROM public.tickets WHERE id = NULLIF('{{ $json.ticket_id }}', '')::INT\n),\nnuevo_ticket AS (\n    INSERT INTO public.tickets (user_id, descripcion_problema, estado, intentos_ia)\n    SELECT \n        {{ $json.user_id }}, \n        '{{ $json.mensaje }}', \n        'en_proceso', \n        {{ $json.intento_actual }}\n    WHERE NOT EXISTS (SELECT 1 FROM ticket_existente)\n    RETURNING id\n),\nticket_final AS (\n    SELECT id FROM ticket_existente\n    UNION ALL\n    SELECT id FROM nuevo_ticket\n)\nINSERT INTO public.historial_chat (ticket_id, user_id, emisor, mensaje, intento_actual)\nSELECT \n    tf.id,\n    {{ $json.user_id }},\n    'usuario',\n    '{{ $json.mensaje }}',\n    {{ $json.intento_actual }}\nFROM ticket_final tf\nRETURNING \n    ticket_id, \n    {{ $json.intento_actual }} AS intento_actual,\n    (SELECT correo FROM public.usuarios WHERE id = {{ $json.user_id }}) AS correo_usuario, \n    (SELECT nombre_completo FROM public.usuarios WHERE id = {{ $json.user_id }}) AS nombre_usuario;",
