    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Recorremos los datos que vienen del Webhook\nreturn $input.all().map(item => {\n    // Obtenemos el cuerpo de la petición (body)\n    const body = item.json.body || item.json;\n    \n    if (body.password) {\n        // Generamos un 'salt' aleatorio de 16 bytes\n        const salt = crypto.randomBytes(16).toString('hex');\n        \n        // Creamos un hash seguro usando scryptSync nativo de Node.js\n        const hash = crypto.scryptSync(body.password, salt, 64).toString('hex');\n        \n        // Guardamos el resultado combinado (salt + hash) en una variable limpia\n        item.json.passwordHash = `${salt}:${hash}`;\n    }\n    \n    return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
