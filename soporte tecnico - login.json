    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nreturn $input.all().map(item => {\n    // Obtenemos la contraseña que el usuario escribió en el formulario (desde el nodo Webhook)\n    // Asegúrate de que tu nodo Webhook se llame exactamente 'Webhook' o cambia el nombre aquí\n    const webhookData = $('Receptor pagina').first().json.body || {};\n    const plainPassword = webhookData.password;\n\n    // Datos que vienen del nodo PostgreSQL (la fila del usuario encontrado)\n    const dbUser = item.json; \n\n    if (!dbUser || !dbUser.password_hash) {\n        item.json.success = false;\n        item.json.message = \"El correo electrónico no está registrado.\";\n        return item;\n    }\n\n    if (dbUser.estado === false) {\n        item.json.success = false;\n        item.json.message = \"Esta cuenta se encuentra inactiva o bloqueada.\";\n        return item;\n    }\n\n    // Extraemos el salt y el hash guardados en PostgreSQL (formato salt:hash)\n    const [salt, originalHash] = dbUser.password_hash.split(':');\n    \n    // Generamos el hash con la contraseña ingresada usando el mismo salt\n    const hashToTest = crypto.scryptSync(plainPassword, salt, 64).toString('hex');\n\n    // Comparamos de forma segura para validar la contraseña\n    const match = crypto.timingSafeEqual(\n        Buffer.from(originalHash, 'hex'),\n        Buffer.from(hashToTest, 'hex')\n    );\n\n    item.json.success = match;\n    item.json.message = match ? \"¡Inicio de sesión exitoso!\" : \"Contraseña incorrecta.\";\n    item.json.data = match ? {\n        id: dbUser.id,\n        nombre: dbUser.nombre_completo,\n        correo: dbUser.correo,\n        rol: dbUser.rol\n    } : null;\n    \n    return item;\n});"
      },
